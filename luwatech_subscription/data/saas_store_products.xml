            <field name="website_sequence">25</field>
            <field name="image_1920" type="base64" file="luwatech_subscription/static/src/img/luwa-etari.png"/>
            <field name="description_sale">Comprehensive Hospital &amp; Clinic Management System (HMS): patient registration &amp; EMR, OPD/IPD ward management, doctor consultations, laboratory &amp; radiology, pharmacy stock, insurance billing &amp; Mobile Money checkout.</field>
        </record>

        <!-- 3. EFRIS & Mobile Money Integration -->
        <record id="product_efris_momo_integration" model="product.template">
            <field name="name">EFRIS &amp; Mobile Money Integration (URA EFRIS, MTN MoMo &amp; Airtel Money)</field>
            <field name="default_code">LUWA-INT-EFRIS-MOMO</field>
