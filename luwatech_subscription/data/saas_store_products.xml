            <field name="website_sequence">15</field>
            <field name="image_1920" type="base64" file="luwatech_subscription/static/src/img/efris-momo-integration.png"/>
            <field name="description_sale">Seamless URA EFRIS tax fiscalization, MTN MoMo &amp; Airtel Money payment collection and disbursement integration for custom ERPs, e-commerce stores, SAP, Zoho, and Microsoft Dynamics 365.</field>
        </record>

        <!-- 4. WhatsApp Integration as a Service -->
        <record id="product_whatsapp_integration" model="product.template">
