<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Store Public Categories -->
        <record id="categ_luwa_saas_systems" model="product.public.category">
            <field name="name">Luwa SaaS Systems</field>
            <field name="sequence">2</field>
        </record>

        <record id="categ_enterprise_erp_crm" model="product.public.category">
            <field name="name">Enterprise ERP &amp; CRM</field>
            <field name="sequence">3</field>
        </record>

        <record id="categ_integrations_apis" model="product.public.category">
            <field name="name">Integrations &amp; APIs</field>
            <field name="sequence">4</field>
        </record>

        <!-- 1. Luwa eShule — School Management System -->
        <record id="product_luwa_eshule" model="product.template">
            <field name="name">Luwa eShule — School Management System</field>
            <field name="default_code">LUWA-ESHULE-001</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="website_published" eval="True"/>
            <field name="is_subscription" eval="False"/>
            <field name="public_categ_ids" eval="[(4, ref('categ_luwa_saas_systems'))]"/>
            <field name="website_sequence">20</field>
            <field name="image_1920" type="base64" file="luwatech_subscription/static/src/img/luwa-eshule.png"/>
            <field name="description_sale">Complete School Management System for nursery, primary, secondary &amp; tertiary institutions: admissions, school fees &amp; Mobile Money reconciliation, exams &amp; report cards, attendance, timetable, library, and parent/student portal.</field>
        </record>

        <!-- 2. Luwa eTari — Hospital Management System -->
        <record id="product_luwa_etari" model="product.template">
            <field name="name">Luwa eTari — Hospital Management System</field>
