<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         1. Luwa Subscription Views (Form, List, Kanban, Search)
         ============================================================ -->
    <record id="view_luwa_subscription_form" model="ir.ui.view">
        <field name="name">luwa.subscription.form</field>
        <field name="model">luwa.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state not in ('draft', 'paused')"/>
                    <button name="action_create_renewal_invoice" string="Create Renewal Invoice" type="object"
                            class="btn-primary" invisible="state not in ('active', 'expired')"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'expired')"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Package">
                            <field name="partner_id"/>
                            <field name="partner_email"/>
                            <field name="partner_phone"/>
                            <field name="product_tmpl_id"/>
                            <field name="plan_id"/>
                            <field name="recurring_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Billing Schedule &amp; Origin">
                            <field name="start_date"/>
                            <field name="next_billing_date"/>
                            <field name="end_date"/>
                            <field name="auto_renew"/>
                            <field name="user_id"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                        </group>
                    </group>
                    <group string="Included Modules">
                        <group>
                            <field name="includes_invoicing"/>
                            <field name="includes_stock_management"/>
                            <field name="includes_payment_gateway"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal subscription notes, provisioning domain, credentials..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_luwa_subscription_list" model="ir.ui.view">
        <field name="name">luwa.subscription.list</field>
        <field name="model">luwa.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-success="state == 'active'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'paused'" decoration-danger="state == 'expired'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="plan_id"/>
                <field name="recurring_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Recurring"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="start_date"/>
                <field name="next_billing_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-warning="state == 'paused'" decoration-danger="state in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_luwa_subscription_kanban" model="ir.ui.view">
        <field name="name">luwa.subscription.kanban</field>
        <field name="model">luwa.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <span class="badge text-bg-primary"><field name="recurring_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                        </div>
                        <div class="text-muted small"><field name="partner_id"/></div>
                        <div class="fw-semibold mt-1"><field name="product_tmpl_id"/></div>
                        <div class="text-muted small mt-1">
                            Next Billing: <field name="next_billing_date"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_luwa_subscription_search" model="ir.ui.view">
        <field name="name">luwa.subscription.search</field>
        <field name="model">luwa.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Paused" name="paused" domain="[('state', '=', 'paused')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="With Payment Gateway" name="with_gateway" domain="[('includes_payment_gateway', '=', True)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Package" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Billing Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_luwa_subscriptions" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">luwa.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer subscription
            </p>
            <p>
                Track recurring E-Commerce and SaaS subscriptions, billing dates, and renewal invoices.
                Website checkout and confirmed Sales Orders with subscription products create subscriptions automatically.
            </p>
        </field>
    </record>

    <!-- ============================================================
         2. Subscription Plans Views
         ============================================================ -->
    <record id="view_luwa_subscription_plan_list" model="ir.ui.view">
        <field name="name">luwa.subscription.plan.list</field>
        <field name="model">luwa.subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="billing_interval"/>
                <field name="billing_unit"/>
                <field name="subscription_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_luwa_subscription_plan_form" model="ir.ui.view">
        <field name="name">luwa.subscription.plan.form</field>
        <field name="model">luwa.subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="billing_interval"/>
                            <field name="billing_unit"/>
                            <field name="subscription_count"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luwa_subscription_plans" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">luwa.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================
         3. Subscription Packages (Product Templates) Action & Views
         ============================================================ -->
    <record id="action_luwa_subscription_products" model="ir.actions.act_window">
        <field name="name">Subscription Packages</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_subscription', '=', True)]</field>
        <field name="context">{
            'default_is_subscription': True,
            'default_type': 'service',
            'default_sale_ok': True,
            'default_purchase_ok': False,
            'default_website_published': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Subscription Package
            </p>
            <p>
                Configure recurring E-Commerce &amp; SaaS products shown on the Luwa Tech website and /shop.
            </p>
        </field>
    </record>

    <record id="product_template_form_view_subscription" model="ir.ui.view">
        <field name="name">product.template.form.luwa.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subscriptions" type="object" class="oe_stat_button"
                        icon="fa-refresh" invisible="not is_subscription">
                    <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span name="subscription_option" class="d-inline-flex ms-3">
                    <field name="is_subscription"/>
                    <label for="is_subscription"/>
                </span>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="subscription" string="Subscription" invisible="not is_subscription">
                    <group>
                        <group string="Billing &amp; Tier">
                            <field name="subscription_plan_id" required="is_subscription"/>
                            <field name="subscription_tier"/>
                            <field name="subscription_category"/>
                            <field name="subscription_badge"/>
                            <field name="subscription_note"/>
                        </group>
                        <group string="Included Modules">
                            <field name="includes_ecommerce"/>
                            <field name="includes_invoicing"/>
                            <field name="includes_stock_management"/>
                            <field name="includes_payment_gateway"/>
                        </group>
                    </group>
                    <group string="Website Feature Checklist (One Per Line)">
                        <field name="subscription_features" nolabel="1" placeholder="Online E-Commerce Storefront&#10;Minimal Invoicing&#10;Stock Management&#10;Integrated Payment Gateway"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_subscription" model="ir.ui.view">
        <field name="name">product.template.search.luwa.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='services']" position="after">
                <filter string="Subscription Modules" name="subscription_modules" domain="[('is_subscription', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         4. Sale Order & Partner Smart Buttons
         ============================================================ -->
    <record id="view_order_form_subscription" model="ir.ui.view">
        <field name="name">sale.order.form.luwa.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subscriptions" type="object" class="oe_stat_button"
                        icon="fa-refresh" invisible="subscription_count == 0">
                    <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_subscription" model="ir.ui.view">
        <field name="name">res.partner.form.luwa.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subscriptions" type="object" class="oe_stat_button"
                        icon="fa-refresh" invisible="subscription_count == 0">
                    <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         5. Backend Menus (Top-Level Subscriptions App + Sales & eCommerce)
         ============================================================ -->
    <menuitem id="menu_luwa_subscription_root"
        name="Subscriptions"
        web_icon="luwatech_subscription,static/description/icon.png"
        groups="sales_team.group_sale_salesman"
        sequence="32">

        <menuitem id="menu_luwa_subscriptions_list"
            name="Customer Subscriptions"
            action="action_luwa_subscriptions"
            sequence="10"/>

        <menuitem id="menu_luwa_subscription_packages"
            name="Subscription Modules"
            action="action_luwa_subscription_products"
            sequence="20"/>

        <menuitem id="menu_luwa_subscription_plans"
            name="Billing Plans"
            action="action_luwa_subscription_plans"
            sequence="30"/>
    </menuitem>

    <!-- Also expose under Sales -> Orders & Sales -> Products -->
    <menuitem id="menu_sale_luwa_subscriptions"
        name="Subscriptions"
        parent="sale.sale_order_menu"
        action="action_luwa_subscriptions"
        groups="sales_team.group_sale_salesman"
        sequence="25"/>

    <menuitem id="menu_sale_luwa_subscription_packages"
        name="Subscription Modules"
        parent="sale.product_menu_catalog"
        action="action_luwa_subscription_products"
        groups="sales_team.group_sale_salesman"
        sequence="15"/>

    <!-- And under Website -> eCommerce -> Products -->
    <menuitem id="menu_ecommerce_luwa_subscription_packages"
        name="Subscription Modules"
        parent="website_sale.menu_catalog"
        action="action_luwa_subscription_products"
        groups="sales_team.group_sale_salesman"
        sequence="2"/>
</odoo>
