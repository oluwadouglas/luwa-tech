<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Luwa Tech Blog Engine Enhancements (/blog & /blog/<post>)
         ============================================================ -->

    <!-- Brand the Blog Index Sidebar "About us" block -->
    <template id="luwa_sidebar_blog_index_about" inherit_id="website_blog.sidebar_blog_index" name="Luwa Tech Blog Sidebar About" priority="50">
        <xpath expr="//div[hasclass('o_wblog_sidebar_block')][1]" position="replace">
            <div class="o_wblog_sidebar_block pb-4 luwa-blog-sidebar-card">
                <span class="luwa-blog-sidebar-kicker">Luwa Tech Editorial</span>
                <h6 class="text-uppercase pb-2 mb-3 border-bottom fw-bold">About Luwa Tech</h6>
                <p class="small text-muted mb-3">
                    Practical playbooks from our Kampala digital agency on performance marketing, e-commerce growth, Mobile Money &amp; URA EFRIS integrations, WhatsApp automation, and custom SaaS.
                </p>
                <div class="d-grid gap-2">
                    <a href="/subscriptions" class="btn btn-primary btn-sm">
                        <i class="fas fa-layer-group me-1"/> View Agency Plans
                    </a>
                    <a href="/contactus" class="btn btn-outline-dark btn-sm">
                        <i class="fas fa-paper-plane me-1"/> Book Strategy Call
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Add Social Distribution Share Bar & CTA at the bottom of every Blog Post -->
    <template id="luwa_blog_post_social_share" inherit_id="website_blog.blog_post_content" name="Luwa Tech Blog Social Share &amp; CTA" priority="50">
        <xpath expr="//div[@t-field='blog_post.content']" position="after">
            <t t-set="luwa_share" t-value="blog_post.get_social_share_urls()"/>
            <div class="luwa-blog-share-bar css_editable_mode_hidden o_not_editable" t-ignore="true">
                <div class="luwa-blog-share-bar__top">
                    <div>
                        <span class="luwa-blog-share-bar__kicker">Share This Article</span>
                        <h4 class="luwa-blog-share-bar__title">Distribute on your social channels</h4>
                    </div>
                    <div class="luwa-blog-share-bar__buttons">
                        <a t-att-href="luwa_share['linkedin']"
                           target="_blank" rel="noopener noreferrer"
                           class="luwa-share-btn luwa-share-btn--linkedin" aria-label="Share on LinkedIn">
                            <i class="fab fa-linkedin-in"/> LinkedIn
                        </a>
                        <a t-att-href="luwa_share['x']"
                           target="_blank" rel="noopener noreferrer"
                           class="luwa-share-btn luwa-share-btn--x" aria-label="Share on X">
                            <i class="fab fa-twitter"/> Share on X
                        </a>
                        <a t-att-href="luwa_share['facebook']"
                           target="_blank" rel="noopener noreferrer"
                           class="luwa-share-btn luwa-share-btn--facebook" aria-label="Share on Facebook">
                            <i class="fab fa-facebook-f"/> Facebook
                        </a>
                        <a t-att-href="luwa_share['whatsapp']"
                           target="_blank" rel="noopener noreferrer"
                           class="luwa-share-btn luwa-share-btn--whatsapp luwa-wa-btn" aria-label="Share on WhatsApp">
                            <i class="fab fa-whatsapp"/> WhatsApp
                        </a>
                        <button type="button"
                                class="luwa-share-btn luwa-share-btn--copy luwa-share-copy-btn"
                                t-att-data-share-url="luwa_share['canonical_url']"
                                aria-label="Copy Article Link">
                            <i class="fas fa-link"/> <span class="luwa-share-copy-label">Copy Link</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="luwa-blog-cta-box css_editable_mode_hidden o_not_editable" t-ignore="true">
                <div class="luwa-blog-cta-box__text">
                    <span class="luwa-blog-cta-box__badge">Kampala Digital Agency &amp; Engineering Studio</span>
                    <h4>Need help launching your online store, marketing retainer, or API integrations?</h4>
                    <p>Start with E-Commerce Starter ($19/mo), Complete w/ Payment Gateway ($29/mo), or Digital Marketing as a Service ($115 / $225/mo).</p>
                </div>
                <div class="luwa-blog-cta-box__actions">
                    <a href="/subscriptions" class="luwa-blog-cta-btn luwa-blog-cta-btn--primary">View Plans</a>
                    <a href="/contactus" class="luwa-blog-cta-btn luwa-blog-cta-btn--outline">Talk to Us</a>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Completely eliminate the bottom next-article banner & picture from blog posts -->
    <template id="luwa_remove_blog_post_footer_banner" inherit_id="website_blog.blog_post_complete" name="Luwa Remove Blog Post Footer Banner" priority="99">
        <xpath expr="//section[@id='o_wblog_post_footer']" position="replace">
            <!-- Completely removed bottom banner & picture per user requirement -->
        </xpath>
    </template>
</odoo>
