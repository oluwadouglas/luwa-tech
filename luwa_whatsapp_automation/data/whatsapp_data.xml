<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="luwa_whatsapp_config_main" model="luwa.whatsapp.config">
            <field name="name">Luwa Tech WhatsApp Engine</field>
            <field name="bridge_url">http://127.0.0.1:3010</field>
            <field name="api_token">luwa-wa-local-2026</field>
        </record>

        <record id="ir_cron_luwa_whatsapp_automations" model="ir.cron">
            <field name="name">Luwa Tech: WhatsApp Payment, Quote &amp; Subscription Reminders</field>
            <field name="model_id" ref="model_luwa_whatsapp_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_whatsapp_automations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_luwa_whatsapp_campaigns" model="ir.cron">
            <field name="name">Luwa Tech: Anti-Ban Bulk WhatsApp Marketing Campaigns</field>
            <field name="model_id" ref="model_luwa_whatsapp_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_running_campaigns()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
